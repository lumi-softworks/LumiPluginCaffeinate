    "Keep Awake & Allow Display Sleep": {
      "comment": "Option to keep system awake but allow display to sleep",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠并允许屏幕关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠並允許螢幕關閉"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Awake & Allow Display Sleep"
          }
        }
      }
    },
    "Keep Awake & Allow Display Sleep: prevents system sleep but lets the display turn off. Use it when you only need the computer to keep running.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠并允许屏幕关闭：阻止系统休眠，但允许屏幕自动熄灭。只需要电脑保持运行时适用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠並允許螢幕關閉：阻止系統休眠，但允許螢幕自動熄滅。只需要電腦保持執行時適用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Awake & Allow Display Sleep: prevents system sleep but lets the display turn off. Use it when you only need the computer to keep running."
          }
        }
      }
    },
    "Keep Awake & Display On": {
      "comment": "Option to keep both system and display awake",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠并保持屏幕常亮"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠並保持螢幕常亮"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Awake & Display On"
          }
        }
      }
    },
    "Keep Awake & Display On: prevents both system sleep and display sleep. Use it for presentations or long reading sessions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠并保持屏幕常亮：同时阻止系统休眠与屏幕休眠。适合演示演示或长时间阅读时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠並保持螢幕常亮：同時阻止系統休眠與螢幕休眠。適合簡報演示或長時間閱讀時使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
