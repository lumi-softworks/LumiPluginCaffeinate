    "Caffeinate": {
      "comment": "Name of the anti-sleep plugin",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防休眠"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "防休眠"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caffeinate"
          }
        }
      }
    },
    "Caffeinate Poster": {
      "comment": "Name of the caffeinate poster plugin",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防休眠海报"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "防休眠海報"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caffeinate Poster"
          }
        }
      }
    },
    "Choose a mode under Actions to start anti-sleep; the checkmark marks the active mode.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「操作」区选择一种模式即可开启防休眠，对勾标识当前生效的模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「操作」區選擇一種模式即可開啟防休眠，打勾標示目前生效的模式。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a mode under Actions to start anti-sleep; the checkmark marks the active mode."
          }
        }
      }
    },
    "Click Reset to restore the built-in durations and drop all custom ones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击「重置」可恢复内置时长，并清除所有自定义时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊「重設」可恢復內建時長，並清除所有自訂時長。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Reset to restore the built-in durations and drop all custom ones."
          }
        }
      }
    },
    "Click the active mode again to stop anti-sleep and release the power assertion.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次点击当前生效的模式可停止防休眠，并释放电源断言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再次點擊目前生效的模式可停止防休眠，並釋放電源斷言。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the active mode again to stop anti-sleep and release the power assertion."
          }
        }
      }
    },
    "Click the delete button next to a custom duration to remove it. Built-in durations cannot be deleted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击自定义时长旁的删除按钮即可移除。内置时长不可删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊自訂時長旁的刪除按鈕即可移除。內建時長不可刪除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the delete button next to a custom duration to remove it. Built-in durations cannot be deleted."
          }
        }
      }
    },
    "Click to prevent system from entering sleep mode": {
      "comment": "Feature description",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击即可阻止系统进入睡眠模式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊即可阻止系統進入睡眠模式"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to prevent system from entering sleep mode"
          }
        }
      }
    },
