          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions"
          }
        }
      }
    },
    "Actions: two anti-sleep modes with a selection checkmark, plus one separate instant-action button below them.": {
      "comment": "",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions: two anti-sleep modes with a selection checkmark, plus one separate instant-action button below them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作：两种防休眠模式带对勾标记，下方另有一个独立的即时动作按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作：兩種防休眠模式帶對勾標記，下方另有一個獨立的即時動作按鈕。"
          }
        }
      }
    },
    "Add Custom (minutes):": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加自定义(分钟):"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "添加自訂(分鐘):"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Custom (minutes):"
          }
        }
      }
    },
    "Add a duration for manual activation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加自定义防休眠时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增自訂防休眠時長。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a duration for manual activation."
          }
        }
      }
    },
    "After it runs, the session keeps the same behaviour as Keep Awake & Allow Display Sleep, so that mode is the one marked with a checkmark.": {
      "comment": "",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After it runs, the session keeps the same behaviour as Keep Awake & Allow Display Sleep, so that mode is the one marked with a checkmark."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行后，会话的行为与「阻止休眠并允许屏幕关闭」一致，因此带对勾的是那一项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行後，會話的行為與「阻止休眠並允許螢幕關閉」一致，因此帶對勾的是那一項。"
          }
        }
      }
    },
    "Anti-Sleep Durations": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防睡眠时长"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "防睡眠時長"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anti-Sleep Durations"
          }
        }
      }
    },
    "Anti-sleep": {
      "comment": "Poster feature title",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
