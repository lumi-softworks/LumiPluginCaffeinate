    "Duration: a horizontal strip of duration buttons. The selected button is highlighted; the strip scrolls sideways when there are many durations.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时长：一排横向排列的时长按钮。选中的按钮会高亮；时长较多时可横向滚动查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時長：一排橫向排列的時長按鈕。選中的按鈕會高亮；時長較多時可橫向捲動檢視。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duration: a horizontal strip of duration buttons. The selected button is highlighted; the strip scrolls sideways when there are many durations."
          }
        }
      }
    },
    "Ensure screen stays on during presentations or work": {
      "comment": "Feature description",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确保演示或工作时屏幕不熄灭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確保演示或工作時螢幕不熄滅"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensure screen stays on during presentations or work"
          }
        }
      }
    },
    "Enter a positive number of minutes in the Add Custom field and click the add button, or press Return.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「添加自定义(分钟)」输入框中填入大于 0 的分钟数，点击添加按钮或按回车键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「新增自訂(分鐘)」輸入框中填入大於 0 的分鐘數，點擊新增按鈕或按回車鍵。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a positive number of minutes in the Add Custom field and click the add button, or press Return."
          }
        }
      }
    },
    "Figure 1: Status-bar popover layout": {
      "localizations": {
        "zh-Hans": {
