          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anti-Sleep Durations"
          }
        }
      }
    },
    "Anti-sleep mode enabled via Wakey": {
      "comment": "Reason shown in system power assertions when anti-sleep is active",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户通过 Wakey 开启了防休眠模式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用戶通過 Wakey 開啟了防休眠模式"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anti-sleep mode enabled via Wakey"
          }
        }
      }
    },
    "Auto-restore Timer": {
      "comment": "Feature title",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定时自动恢复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "定時自動恢復"
